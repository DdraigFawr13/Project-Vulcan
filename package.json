{
  "name": "project-vulcan",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node .claude/skills/test-design/scripts/test-traps.mjs && node tools/check.mjs",
    "check:full": "node tools/check.mjs --full",
    "check:all": "node tools/check.mjs --all",
    "typecheck": "tsc --noEmit",
    "boundaries": "node tools/check-boundaries.mjs",
    "limits": "node tools/check-limits.mjs",
    "shape": "node tools/check-shape.mjs",
    "codemap": "node tools/codemap.mjs",
    "reading-cost": "node tools/reading-cost.mjs",
    "map:stats": "node tools/map-stats.mjs",
    "map:render": "node tools/map-stats.mjs --render",
    "budget": "node tools/budget.mjs",
    "balance": "node tools/balance.mjs",
    "annals": "node tools/annals.mjs",
    "families": "node tools/families.mjs",
    "heat": "node tools/heat.mjs",
    "paths": "node tools/paths.mjs",
    "stages": "node tools/stages.mjs",
    "teach": "node tools/teach.mjs",
    "callings": "node tools/callings.mjs",
    "decade": "node tools/decade.mjs",
    "timeuse": "node tools/timeuse.mjs",
    "speed": "node tools/speed.mjs",
    "discover": "node tools/discover.mjs",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:browser": "playwright test",
    "test:stress": "node tools/browser-stress.mjs",
    "coverage": "vitest run --coverage && node tools/coverage-summary.mjs",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache ."
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "story-generator": "https://codeload.github.com/DdraigFawr13/Story-Generator/tar.gz/6430856302a3b70c4f45da424251b323b08e6615"
  }
}
